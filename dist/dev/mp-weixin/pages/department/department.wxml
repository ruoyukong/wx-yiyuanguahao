<view class="department-container data-v-0628aff4"><view class="page-header data-v-0628aff4"><block wx:if="{{isShowDoctorList}}"><uni-icons vue-id="beec4c80-1" type="back" size="20" color="#333" data-event-opts="{{[['^click',[['backToDeptList']]]]}}" bind:click="__e" class="data-v-0628aff4" bind:__l="__l"></uni-icons></block><text class="header-title data-v-0628aff4">{{''+(isShowDoctorList?currentDept.name+' - 医生列表':'科室信息')+''}}</text></view><block wx:if="{{!isShowDoctorList}}"><view class="hospital-selector-container data-v-0628aff4"><view class="hospital-selector data-v-0628aff4"><picker mode="selector" range="{{hospitalList}}" value="{{selectedHospitalIndex}}" range-key="name" data-event-opts="{{[['change',[['handleHospitalChange',['$event']]]]]}}" bindchange="__e" class="data-v-0628aff4"><view class="picker-display data-v-0628aff4"><text class="picker-label data-v-0628aff4">选择医院</text><text class="picker-value data-v-0628aff4">{{hospitalList[selectedHospitalIndex].name}}</text><uni-icons class="picker-icon data-v-0628aff4" vue-id="beec4c80-2" type="arrow-right" size="16" color="#666" bind:__l="__l"></uni-icons></view></picker></view></view></block><block wx:if="{{isLoading}}"><view class="loading data-v-0628aff4"><view class="loading-spinner data-v-0628aff4"></view><text class="data-v-0628aff4">{{isShowDoctorList?'加载医生信息中...':'加载中...'}}</text></view></block><block wx:if="{{errorMsg&&!isLoading}}"><view class="error data-v-0628aff4"><text class="error-icon data-v-0628aff4">❌</text><text class="error-text data-v-0628aff4">{{errorMsg}}</text></view></block><block wx:if="{{$root.g0}}"><view class="department-list data-v-0628aff4"><block wx:for="{{departmentList}}" wx:for-item="dept" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['handleDeptClick',['$0'],[[['departmentList','id',dept.id]]]]]]]}}" class="department-item data-v-0628aff4" bindtap="__e"><view class="dept-header data-v-0628aff4"><text class="dept-name data-v-0628aff4">{{dept.name}}</