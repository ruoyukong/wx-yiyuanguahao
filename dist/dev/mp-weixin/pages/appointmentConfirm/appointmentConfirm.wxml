<view class="confirm-container data-v-c5c136b4"><view class="page-header data-v-c5c136b4">确认预约信息</view><view class="form-card data-v-c5c136b4"><view class="form-section data-v-c5c136b4"><view class="section-title data-v-c5c136b4">预约信息</view><view class="info-item data-v-c5c136b4"><view class="info-label data-v-c5c136b4">就诊医生：</view><view class="info-value data-v-c5c136b4">{{appointmentInfo.doctorName}}</view></view><view class="info-item data-v-c5c136b4"><view class="info-label data-v-c5c136b4">就诊日期：</view><view class="info-value data-v-c5c136b4">{{$root.m0}}</view></view><view class="info-item data-v-c5c136b4"><view class="info-label data-v-c5c136b4">就诊时间：</view><view class="info-value data-v-c5c136b4">{{$root.f0}}</view></view><view class="info-item data-v-c5c136b4"><view class="info-label data-v-c5c136b4">预约门诊：</view><view class="info-value data-v-c5c136b4">{{appointmentInfo.diseaseName}}</view></view></view><view class="form-section data-v-c5c136b4"><view class="section-title data-v-c5c136b4">就诊人信息</view><view class="form-input-item data-v-c5c136b4"><view class="input-label data-v-c5c136b4">姓名</view><input class="input-field data-v-c5c136b4" type="text" placeholder="请输入就诊人姓名" data-event-opts="{{[['input',[['__set_model',['$0','real_name','$event',[]],['patientInfo']]]]]}}" value="{{patientInfo.real_name}}" bindinput="__e"/></view><view class="form-input-item data-v-c5c136b4"><view class="input-label data-v-c5c136b4">身份证号</view><input class="input-field data-v-c5c136b4" type="text" placeholder="请输入就诊人身份证号" data-event-opts="{{[['input',[['__set_model',['$0','id_card','$event',[]],['patientInfo']]]]]}}" value="{{patientInfo.id_card}}" bindinput="__e"/></view></view><view class="form-section data-v-c5c136b4"><view class="fee-item data-v-c5c136b4"><view class="fee-label data-v-c5c136b4">预约费用</view><view class="fee-value data-v-c5c136b4">{{"¥"+appointmentInfo.unit_price}}</view></view></view></view><view class="action-bar data-v-c5c136b4"><button data-event-opts="{{[['tap',[['handleCancel',['$event']]]]]}}" class="cancel-btn data-v-c5c136b4" bindtap="__e">取消预约</button><button data-event-opts="{{[['tap',[['handleConfirm',['$event']]]]]}}" class="confirm-btn data-v-c5c136b4" bindtap="__e">确认预约</button></view></view>