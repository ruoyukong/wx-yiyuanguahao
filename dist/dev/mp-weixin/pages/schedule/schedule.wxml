<view class="schedule-container data-v-f8d83f34"><view class="page-header data-v-f8d83f34">{{"选择就诊"+diseaseName+"时间"}}</view><scroll-view class="date-scroll data-v-f8d83f34" scroll-x="true"><block wx:for="{{dateList}}" wx:for-item="date" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['selectDate',[index]]]]]}}" class="{{['date-item','data-v-f8d83f34',(selectedDateIndex===index)?'active':'',(date.isPast)?'past':'']}}" bindtap="__e"><view class="week-day data-v-f8d83f34">{{date.weekDay}}</view><view class="date data-v-f8d83f34">{{date.date}}</view><block wx:if="{{date.isNextWeek}}"><view class="next-week-tag data-v-f8d83f34">下周</view></block></view></block></scroll-view><view class="content data-v-f8d83f34"><block wx:if="{{isLoading}}"><view class="loading data-v-f8d83f34"><uni-icons vue-id="222ea540-1" type="loading" size="40" color="#007aff" class="data-v-f8d83f34" bind:__l="__l"></uni-icons><view class="loading-text data-v-f8d83f34">正在加载排班信息...</view></view></block><block wx:if="{{!isLoading}}"><view class="schedule-list data-v-f8d83f34"><block wx:for="{{$root.l0}}" wx:for-item="slot" wx:for-index="slotIndex" wx:key="slotIndex"><view class="time-slot data-v-f8d83f34"><view class="time-slot-title data-v-f8d83f34">{{slot.$orig.time_slot}}</view><view class="doctor-list data-v-f8d83f34"><block wx:if="{{slot.g0}}"><view class="no-doctor data-v-f8d83f34"><uni-icons vue-id="{{'222ea540-2-'+slotIndex}}" type="none" size="40" color="#cccccc" class="data-v-f8d83f34" bind:__l="__l"></uni-icons><view class="no-doctor-text data-v-f8d83f34">该时段暂无医生出诊</view></view></block><block wx:for="{{slot.$orig.doctors}}" wx:for-item="item" wx:for-index="itemIndex" wx:key="itemIndex"><view class="doctor-item data-v-f8d83f34"><view class="doctor-info data-v-f8d83f34"><view class="doctor-details data-v-f8d83f34"><view class="doctor-name data-v-f8d83f34">{{item.doctor.name+''}}<text class="doctor-title data-v-f8d83f34">{{item.doctor.title}}</text></view><view class="doctor-good-at data-v-f8d83f34">{{"擅长: "+item.doctor.good_at}}</view><view class="price data-v-f8d83f34">{{"¥"+item.price}}</view></view></view><view class="appointment-status data-v-f8d83f34"><view class="remaining data-v-f8d83f34">{{item.remaining+"/"+item.total+"个号"}}</view><button class="{{['appointment-btn','data-v-f8d83f34',(item.remaining<=0)?'disabled':'']}}" disabled="{{item.remaining<=0}}" data-event-opts="{{[['tap',[['handleAppointment',['$0'],[[['schedules','',slotIndex],['doctors','',itemIndex]]]]]]]}}" bindtap="__e">{{''+(item.remaining>0?'预约':'已约满')+''}}</button></view></view></block></view></view></block></view></block></view></view>