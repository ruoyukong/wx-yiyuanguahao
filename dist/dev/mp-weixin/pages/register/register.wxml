<view class="register-container data-v-891c2434"><view class="page-title data-v-891c2434">预约挂号</view><block wx:if="{{hospitalSelected}}"><view class="global-search-area data-v-891c2434"><view class="search-bar data-v-891c2434"><input class="search-input data-v-891c2434" type="text" placeholder="搜索门诊..." data-event-opts="{{[['input',[['__set_model',['','searchKeyword','$event',[]]],['handleSearchInput',['$event']]]],['focus',[['handleSearchFocus',['$event']]]]]}}" value="{{searchKeyword}}" bindinput="__e" bindfocus="__e"/><view data-event-opts="{{[['tap',[['handleSearchAction',['$event']]]]]}}" class="search-action-btn data-v-891c2434" bindtap="__e">{{''+(showClearBtn?'清空':'搜索')+''}}</view></view><block wx:if="{{$root.g0}}"><view class="search-results data-v-891c2434"><view class="search-results-title data-v-891c2434">{{"搜索结果 ("+$root.g1+")"}}</view><block wx:for="{{searchedDiseases}}" wx:for-item="disease" wx:for-index="index" wx:key="index"><view class="disease-item data-v-891c2434"><view class="disease-header data-v-891c2434"><view class="disease-name data-v-891c2434">{{disease.disease_name}}</view><view data-event-opts="{{[['tap',[['handleDiseaseAppointment',['$0'],[[['searchedDiseases','',index]]]]]]]}}" class="appoint-btn data-v-891c2434" bindtap="__e">预约挂号</view></view><view class="doctor-group data-v-891c2434"><block wx:for="{{disease.doctors}}" wx:for-item="doctor" wx:for-index="docIndex" wx:key="docIndex"><view class="doctor-item data-v-891c2434"><view class="doctor-info data-v-891c2434"><view class="doctor-name data-v-891c2434">{{doctor.name+''}}<text class="doctor-title data-v-891c2434">{{doctor.title}}</text></view><view class="doctor-good-at data-v-891c2434">{{"擅长: "+doctor.good_at}}</view></view></view></block></view></view></block></view></block><block wx:if="{{$root.g2}}"><view class="search-results data-v-891c2434"><view class="no-results data-v-891c2434">未找到匹配的疾病</view></view></block></view></block><block wx:if="{{!hospitalSelected}}"><view class="hospital-selection data-v-891c2434"><view class="selection-prompt data-v-891c2434">请选择您要预约的医院</view><view class="hospital-buttons data-v-891c2434"><block wx:for="{{hospitalList}}" wx:for-item="hospital" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['selectHospital',['$0','$1'],[[['hospitalList','id',hospital.id,'id']],[['hospitalList','id',hospital.id,'index']]]]]]]}}" class="hospital-btn data-v-891c2434" bindtap="__e">{{''+hospital.name+''}}</view></block></view></view></block><block wx:else><view class="main-content data-v-891c2434"><view class="department-nav data-v-891c2434"><view class="nav-header data-v-891c2434">科室列表</view><scroll-view class="department-scroll data-v-891c2434" scroll-y="{{true}}"><block wx:for="{{departmentList}}" wx:for-item="dept" wx:for-index="__i1__" wx:key="id"><view data-event-opts="{{[['tap',[['handleDepartmentClick',['$0'],[[['departmentList','id',dept.id,'id']]]]]]]}}" class="{{['department-item','data-v-891c2434',(selectedDepartmentId===dept.id)?'active':'']}}" bindtap="__e">{{''+dept.name+''}}</view></block></scroll-view></view><view class="disease-list data-v-891c2434"><block wx:if="{{isLoadingDisease}}"><view class="loading-state data-v-891c2434"><uni-icons vue-id="9a676040-1" type="loading" size="40" color="#007aff" class="data-v-891c2434" bind:__l="__l"></uni-icons><text class="data-v-891c2434">正在加载信息...</text></view></block><block wx:else><block wx:if="{{$root.g3>0}}"><view class="data-v-891c2434"><block wx:for="{{diseaseList}}" wx:for-item="disease" wx:for-index="diseaseIndex" wx:key="diseaseIndex"><view class="disease-item data-v-891c2434"><view class="disease-header data-v-891c2434"><view class="disease-name data-v-891c2434">{{disease.disease_name}}</view><view data-event-opts="{{[['tap',[['handleDiseaseAppointment',['$0'],[[['diseaseList','',diseaseIndex]]]]]]]}}" class="appoint-btn data-v-891c2434" bindtap="__e">预约挂号</view></view><view class="doctor-group data-v-891c2434"><block wx:for="{{disease.doctors}}" wx:for-item="doctor" wx:for-index="doctorIndex" wx:key="doctorIndex"><view class="doctor-item data-v-891c2434"><view class="doctor-info data-v-891c2434"><view class="doctor-name data-v-891c2434">{{doctor.name+''}}<text class="doctor-title data-v-891c2434">{{doctor.title}}</text></view><view class="doctor-good-at data-v-891c2434">{{"擅长: "+doctor.good_at}}</view></view></view></block></view></view></block></view></block><block wx:else><block wx:if="{{selectedDepartmentId&&!isLoadingDisease}}"><view class="empty-state data-v-891c2434"><text class="data-v-891c2434">该科室暂无数据</text></view></block><block wx:else><block wx:if="{{!isLoadingDisease}}"><view class="empty-state data-v-891c2434"><text class="data-v-891c2434">{{''+(searchKeyword?'未找到匹配的门诊':'请先从左侧选择一个科室')+''}}</text></view></block></block></block></block></view></view></block></view>